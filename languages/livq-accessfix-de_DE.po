#. Description of the plugin
#: livq-accessfix.php
msgid ""
"Automated WCAG 2.2 AA & European Accessibility Act (EAA) remediation for "
"WordPress: focus styles, external link labels, skip links, alt attributes, "
"heading hierarchy, ARIA menus, and Gutenberg pre-publish checks - zero "
"configuration required."
msgstr ""
"Automatische WCAG 2.2 AA- und EAA-Korrekturen für WordPress: Fokus-Stile, "
"externe Link-Labels, Skip-Links, Alt-Attribute, Überschriftenhierarchie, "
"ARIA-Menüs und Gutenberg-Vorveröffentlichungsprüfungen - keine Konfiguration "
"erforderlich."

#. Author of the plugin
#: livq-accessfix.php
msgid "LivQ"
msgstr ""

#. Author URI of the plugin
#: livq-accessfix.php
msgid "https://skapacraft.com"
msgstr ""

