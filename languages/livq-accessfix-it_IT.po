msgid "LivQ AccessFix – EAA & A11y AutoFix"
msgstr "LivQ AccessFix – EAA & A11y AutoFix"

#. Plugin URI of the plugin
#: livq-accessfix.php
msgid "https://skapacraft.com/tools/plugins/livq-accessfix/"
msgstr ""

#. Description of the plugin
#: livq-accessfix.php
msgid ""
"Automated WCAG 2.2 AA & European Accessibility Act (EAA) remediation for "
"WordPress: focus styles, external link labels, skip links, alt attributes, "
"heading hierarchy, ARIA menus, and Gutenberg pre-publish checks - zero "
"configuration required."
msgstr ""
"Correzione automatica WCAG 2.2 AA e European Accessibility Act (EAA) per "
"WordPress: stili focus, etichette link esterni, skip link, attributi alt, "
"gerarchia titoli, menu ARIA e controlli pre-pubblicazione Gutenberg - zero "
"configurazione richiesta."

#. Author of the plugin
#: livq-accessfix.php
msgid "LivQ"
msgstr ""

#. Author URI of the plugin
#: livq-accessfix.php
msgid "https://skapacraft.com"
msgstr ""

